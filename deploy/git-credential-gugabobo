#!/bin/sh
set -eu

host=""
while IFS="=" read -r key value; do
  if [ "$key" = "host" ]; then
    host="$value"
  fi
done

if [ "${1:-}" != "get" ] || [ "$host" != "github.com" ]; then
  exit 0
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
env_file="${GUGABOBO_CONFIG_FILE_PATH:-$script_dir/../.env}"
if [ ! -r "$env_file" ]; then
  exit 0
fi

token=$(sed -n 's/^GUGABOBO_GITHUB_TOKEN=//p' "$env_file" | head -n 1 | tr -d '\r')
if [ -z "$token" ]; then
  exit 0
fi

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
