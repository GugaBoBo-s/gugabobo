FROM python:3.11-bookworm

ARG CLAUDE_CODE_VERSION=2.1.202
ARG DEBIAN_MIRROR=

RUN if [ -n "${DEBIAN_MIRROR}" ]; then \
      sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
      mirror_host="${DEBIAN_MIRROR#*://}"; \
      mirror_host="${mirror_host%%/*}"; \
      printf 'Acquire::http::Proxy::%s "DIRECT";\nAcquire::https::Proxy::%s "DIRECT";\n' \
        "$mirror_host" "$mirror_host" > /etc/apt/apt.conf.d/99mirror-direct; \
    fi \
    && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 update \
    && apt-get install -y --no-install-recommends git nodejs npm \
    && npm install --fetch-retries=5 --fetch-retry-maxtimeout=120000 \
      -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/gugabobo

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir ".[dev]" \
    && useradd --create-home --uid 1000 runner \
    && mkdir -p /workspace \
    && chown -R runner:runner /workspace /home/runner

USER runner
WORKDIR /workspace

CMD ["claude", "--version"]
