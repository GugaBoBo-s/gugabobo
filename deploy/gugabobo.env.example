# gugabobo server environment
# Copy to /opt/gugabobo/repo/.env on the server and fill in the secrets.
# This file holds the GuGabobo bot token, so keep it chmod 600.

GUGABOBO_ENV=prod

# Absolute paths keep runtime state under /opt/gugabobo/data,
# separate from the source clone in /opt/gugabobo/repo.
GUGABOBO_DATA_DIR=/opt/gugabobo/data
GUGABOBO_DB_PATH=/opt/gugabobo/data/gugabobo.db
GUGABOBO_LOG_DIR=/opt/gugabobo/data/logs
GUGABOBO_SANDBOX_DIR=/opt/gugabobo/data/sandbox
GUGABOBO_RUNNER_HOME_DIR=/opt/gugabobo/data/claude-home
GUGABOBO_CONFIG_FILE_PATH=/opt/gugabobo/repo/.env
# Keep guidance outside the source clone. `edit_agent_guidance` writes soul.md and
# rules.md at runtime, and a deploy rollback runs `git reset --hard`, which would
# discard owner edits stored inside /opt/gugabobo/repo.
GUGABOBO_PROMPT_GUIDANCE_DIR=/opt/gugabobo/data/guidance

# API binds to localhost only; reach the dashboard over an SSH tunnel.
GUGABOBO_API_HOST=127.0.0.1
GUGABOBO_API_PORT=8765
GUGABOBO_ADMIN_TOKEN=change-me-to-a-long-random-string

# GitHub: use a Personal Access Token from the GuGabobo bot account so
# pushes and pull requests are attributed to the bot, not the owner.
GUGABOBO_GITHUB_TOKEN=
GUGABOBO_GITHUB_OWNER=GugaBoBo-s
GUGABOBO_GITHUB_REPO=gugabobo
GUGABOBO_GITHUB_API_URL=https://api.github.com
GUGABOBO_GITHUB_REVIEW_ENABLED=false
GUGABOBO_GITHUB_ORGANIZATION=GugaBoBo-s
GUGABOBO_GITHUB_REVIEW_INTERVAL_SECONDS=300
GUGABOBO_GITHUB_REVIEW_MAX_FILES=3000
GUGABOBO_GITHUB_REVIEW_MAX_PATCH_CHARS=120000
GUGABOBO_GITHUB_ISSUE_ENABLED=false
GUGABOBO_GITHUB_ISSUE_INTERVAL_SECONDS=600
GUGABOBO_GITHUB_ISSUE_MAX_PER_SCAN=20
GUGABOBO_GITHUB_ISSUE_MIN_CONFIDENCE=0.75
GUGABOBO_GITHUB_ISSUE_AUTO_FIX_ENABLED=true
# Empty means only GUGABOBO_GITHUB_OWNER/GUGABOBO_GITHUB_REPO. Use comma-separated
# owner/repo values or * only after every target repository has appropriate checks.
GUGABOBO_GITHUB_ISSUE_AUTO_FIX_REPOSITORIES=
GUGABOBO_AUTO_DEPLOY_ENABLED=true
GUGABOBO_GIT_AUTHOR_NAME=GuGabobo
GUGABOBO_GIT_AUTHOR_EMAIL=263493647+GuGabobo@users.noreply.github.com

# Claude Code runner (self-improvement). Use an Anthropic-compatible gateway
# with the two values below, or leave them blank and authenticate the dedicated
# runner home interactively.
GUGABOBO_CLAUDE_BIN=claude
GUGABOBO_CLAUDE_BASE_URL=
GUGABOBO_CLAUDE_AUTH_TOKEN=
GUGABOBO_CODE_CLAUDE_MODEL=claude-opus-4-8
GUGABOBO_CODE_OPENAI_MODEL=gpt-5.6-sol
GUGABOBO_CODE_DEEPSEEK_MODEL=deepseek-v4-pro
GUGABOBO_CODE_DEEPSEEK_RUNNER_MODEL=deepseek-v4-pro[1m]
GUGABOBO_CODE_MODEL_TIMEOUT_SECONDS=120
GUGABOBO_CLAUDE_TIMEOUT_SECONDS=900
GUGABOBO_CLAUDE_MAX_BUDGET_USD=5
GUGABOBO_SANDBOX_CHECK_TIMEOUT_SECONDS=300
GUGABOBO_RUNNER_CONTAINER_RUNTIME=docker
GUGABOBO_RUNNER_CONTAINER_IMAGE=gugabobo-runner:local
GUGABOBO_RUNNER_MEMORY_LIMIT=2g
GUGABOBO_RUNNER_CPU_LIMIT=2
GUGABOBO_RUNNER_PIDS_LIMIT=256
GUGABOBO_DOCKER_PROXY=
GUGABOBO_DEBIAN_MIRROR=

# LLM provider
GUGABOBO_LLM_PROVIDER=moonshot
GUGABOBO_MOONSHOT_API_KEY=
GUGABOBO_MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
GUGABOBO_MOONSHOT_MODEL=kimi-k2.6
GUGABOBO_DEEPSEEK_API_KEY=
GUGABOBO_DEEPSEEK_BASE_URL=https://api.deepseek.com
GUGABOBO_DEEPSEEK_MODEL=deepseek-v4-flash
GUGABOBO_OPENAI_API_KEY=
GUGABOBO_OPENAI_BASE_URL=https://api.openai.com/v1
GUGABOBO_OPENAI_MODEL=gpt-5.6
GUGABOBO_LLM_TIMEOUT_SECONDS=60
GUGABOBO_LLM_CONTEXT_MESSAGES=400
GUGABOBO_LLM_MEMORY_ITEMS=12
GUGABOBO_LLM_HISTORY_TOKEN_BUDGET=24000
GUGABOBO_LLM_SUMMARY_TRIGGER_TOKENS=24000
GUGABOBO_LLM_SUMMARY_KEEP_RECENT_TOKENS=8000

# Telegram (local polling on the server; no public webhook required)
GUGABOBO_TELEGRAM_BOT_TOKEN=
GUGABOBO_TELEGRAM_BOT_USERNAME=
GUGABOBO_TELEGRAM_REPLY_ENABLED=false
GUGABOBO_OWNER_TELEGRAM_IDS=
GUGABOBO_TELEGRAM_GROUP_WAKE_WORDS=gugabobo,咕嘎BoBo
# Use socks5:// rather than socks5h://. python-socks rejects the socks5h and
# socks4a schemes, and SOCKS5 already resolves hostnames remotely there.
GUGABOBO_TELEGRAM_PROXY=
GUGABOBO_TELEGRAM_COMMUNITY_GROUP_URL=https://t.me/ScarletKc_Group
GUGABOBO_TELEGRAM_COMPANION_BOT_URL=https://t.me/FogMoeBot
GUGABOBO_TELEGRAM_ANNOUNCEMENT_CHANNEL_URL=https://t.me/FOG_MOE
GUGABOBO_TELEGRAM_SUMMARY_BOT_URL=https://t.me/rigerubot?startgroup=true
GUGABOBO_TELEGRAM_DEVELOPER_GUGABOBO_URL=https://t.me/woshigugabobo
GUGABOBO_TELEGRAM_DEVELOPER_SCARLETKC_URL=https://t.me/scarletkc
GUGABOBO_TELEGRAM_GITHUB_SCARLETKC_URL=https://github.com/scarletkc
GUGABOBO_TELEGRAM_GITHUB_FOGMOE_URL=https://github.com/FogMoe
GUGABOBO_TELEGRAM_GITHUB_GEYUGONG_URL=https://github.com/orgs/FogMoe/people/GeYugong
GUGABOBO_TELEGRAM_GITHUB_GUGABOBO_URL=https://github.com/GugaBoBo-s

# QQ / NapCat (optional; NapCat runs separately)
GUGABOBO_OWNER_QQ_IDS=
GUGABOBO_NAPCAT_API_URL=http://127.0.0.1:3000
GUGABOBO_NAPCAT_REPLY_ENABLED=false
GUGABOBO_NAPCAT_PASSIVE_REPLY_ENABLED=false
GUGABOBO_QQ_GROUP_WAKE_WORDS=gugabobo,咕嘎BoBo
