[Unit]
Description=gugabobo management API and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/opt/gugabobo/repo
EnvironmentFile=/opt/gugabobo/repo/.env
ExecStart=/opt/gugabobo/repo/.venv/bin/gugabobo api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/opt/gugabobo/repo/.env /opt/gugabobo/data

[Install]
WantedBy=multi-user.target
